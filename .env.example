# NutriDSS Environment Variables Example
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8000
DATABASE_URL=sqlite:///database/nutridss.db
ML_MODEL_PATH=models/best_recipe_ranker.joblib
JWT_SECRET_KEY=nutridss_insecure_default_secret_replace_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
RATE_LIMIT_PER_MINUTE=60
USDA_FDC_API_KEY=
